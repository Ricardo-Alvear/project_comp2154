# --- Dependencies ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Environment / Secrets (CRITICAL) ---
.env
.env.local
backend/.env
frontend/.env

# --- User Uploads & Tax Records (CRITICAL) ---
# This prevents your personal tax PDFs from being pushed
backend/uploads/tax_records/*.pdf
backend/uploads/tax_records/*.xlsx
backend/uploads/tax_records/*.csv
# Keep the folder structure but not the files
!backend/uploads/tax_records/.gitkeep

# --- Build Folders ---
dist/
dist-ssr/
build/
frontend/dist/

# --- Operating System Files ---
.DS_Store
Thumbs.db

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*